# Local-only settings. Never commit the real .env file or share its values.

# Required: generate a private random value, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-private-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=true

# Providers: keep both as mock until the corresponding service is tested and approved.
TRANSLATION_PROVIDER=mock
TTS_PROVIDER=mock

# DeepSeek (server-side only; do not paste keys into chat or commit them).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Alibaba Cloud Bailian / CosyVoice 3.5 Plus.
# Create an API key and optional Beijing workspace ID in the Bailian console.
DASHSCOPE_API_KEY=
DASHSCOPE_WORKSPACE_ID=
COSYVOICE_TTS_MODEL=cosyvoice-v3.5-plus
COSYVOICE_TTS_VOICE_US=
COSYVOICE_TTS_VOICE_UK=
COSYVOICE_TTS_BASE_URL=https://dashscope.aliyuncs.com/api/v1
COSYVOICE_TTS_WS_URL=wss://dashscope.aliyuncs.com/api-ws/v1/inference
COSYVOICE_TTS_SAMPLE_RATE=24000
COSYVOICE_TTS_TIMEOUT=60

# Volcengine Doubao TTS (V3 SSE; only fill after credentials are verified).
# New console: set VOLCENGINE_API_KEY (preferred).
# Legacy console: set VOLCENGINE_APP_ID and VOLCENGINE_ACCESS_TOKEN.
VOLCENGINE_API_KEY=
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=
# American English voice, e.g. en_female_hayley_uranus_bigtts for 2.0.
VOLCENGINE_TTS_VOICE=
# British English voice. Leave empty to fall back to the American voice.
VOLCENGINE_TTS_VOICE_UK=en_female_authoritative-british_uranus_bigtts
# Resource ID must match the voice generation: seed-tts-2.0 or seed-tts-1.0.
VOLCENGINE_RESOURCE_ID=seed-tts-2.0
VOLCENGINE_TTS_SAMPLE_RATE=24000
VOLCENGINE_TTS_NORMAL_SPEECH_RATE=-20
VOLCENGINE_TTS_SLOW_SPEECH_RATE=-35
VOLCENGINE_TTS_WORD_SPEECH_RATE=-20

# Word-level pronunciation assessment. Keep mock until Tencent SOE is configured.
# New accounts must use the new SOE (WebSocket) product, not the retired basic version.
ASSESSMENT_PROVIDER=mock
ASSESSMENT_DAILY_REQUEST_LIMIT=30
TENCENT_SOE_APP_ID=
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENT_SOE_ENGINE=16k_en
TENCENT_SOE_SCORE_COEFF=1.0
TENCENT_SOE_TIMEOUT=20

# Tencent OCR (GeneralBasicOCR). Keep mock until the real OCR test passes.
OCR_PROVIDER=mock
TENCENT_OCR_REGION=ap-guangzhou
OCR_DAILY_REQUEST_LIMIT=10

# Conservative per-user limits before real paid calls.
TRANSLATION_DAILY_REQUEST_LIMIT=20
TTS_DAILY_CHAR_LIMIT=5000
