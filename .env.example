# Local-only settings. Never commit the real .env file or share its values.

# Required: generate a private random value, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=replace-with-a-private-random-value
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=true

# Providers: keep both as mock until the corresponding service is tested and approved.
TRANSLATION_PROVIDER=mock
TTS_PROVIDER=mock

# DeepSeek (server-side only; do not paste keys into chat or commit them).
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Volcengine Doubao TTS (only fill after credentials are verified).
VOLCENGINE_APP_ID=
VOLCENGINE_ACCESS_TOKEN=
VOLCENGINE_TTS_VOICE=

# Conservative per-user limits before real paid calls.
TRANSLATION_DAILY_REQUEST_LIMIT=20
TTS_DAILY_CHAR_LIMIT=5000
